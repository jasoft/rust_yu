{
  "name": "webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:i18n && vitest run --exclude tests/programFilters.test.mjs && node --experimental-strip-types --test tests/programFilters.test.mjs",
